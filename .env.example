# This lab talks to an LLM through the OpenAI-compatible client.
# We point that client at Fireworks AI. Copy this file to `.env` and fill in your key.

# Your Fireworks API key (used as the OpenAI api_key).
OPENAI_API_KEY=your_fireworks_api_key_here

# Fireworks' OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# A Fireworks model that supports tool/function calling.
# Change this to whatever you have access to on Fireworks.
MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
