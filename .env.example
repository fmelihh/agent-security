# This lab talks to an LLM through the OpenAI-compatible client.
# By default it runs a small local model with Docker Model Runner — no hosted
# API, no key, everything on your machine. Copy this file to `.env`.

# Any non-empty value works for a local model (it is ignored by the runner).
OPENAI_API_KEY=local

# A small local model via Docker Model Runner:
#   docker desktop start
#   docker model pull ai/qwen2.5:1.5B-F16
OPENAI_BASE_URL=http://localhost:12434/engines/v1
MODEL=ai/qwen2.5:1.5B-F16

# To use a different OpenAI-compatible endpoint instead, set OPENAI_BASE_URL,
# MODEL and OPENAI_API_KEY to that provider's values. The lab code never changes.
