# The model and endpoint are hard-coded in lab/agent.py (a small local model
# served by Docker Model Runner), so a .env file is optional.
#
# The local runner ignores the API key, and the code already falls back to
# "local", so you usually don't need this at all. Copy this file to `.env` only
# if you want to override the key.
OPENAI_API_KEY=local
